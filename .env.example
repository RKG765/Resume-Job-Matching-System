# Resume-Job Matching System - Cloud Environment Configuration
# Copy this to .env and fill in your values

# ============ Application ============
APP_NAME="Resume-Job Matching System"
APP_VERSION="2.0.0"
DEBUG=false

# ============ Server ============
HOST=0.0.0.0
PORT=8000

# ============ Database ============
# For cloud: Use your cloud DB connection string
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/resume_matcher

# For SQLite (simpler cloud deploy, no external DB needed)
USE_SQLITE=true
SQLITE_URL=sqlite+aiosqlite:///./resume_matcher.db

# ============ Embeddings ============
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ============ LLM Settings ============
# Get a free key at https://console.groq.com
LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_ENABLED=true

# ============ File Upload ============
MAX_UPLOAD_SIZE=16777216
UPLOAD_DIR=data/uploads

# ============ CORS ============
# Use * to allow all origins (easiest for cloud)
# Or comma-separated URLs: https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=*
